#!/bin/sh
#
# Export primary Cursor chat to docs/chats/ before each commit.
# Enable once per clone: git config core.hooksPath .githooks
#

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if command -v php >/dev/null 2>&1; then
  php scripts/export-cursor-chat.php || true

  if [ -d docs/chats ]; then
    git add docs/chats/*.md 2>/dev/null || true
  fi
fi

exit 0
